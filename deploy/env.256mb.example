# Ready-to-use .env for a 256 MB host.
#
#   cp deploy/env.256mb.example .env      # then paste your token
#
# On a panel that offers only a file manager, upload this as ".env" next to
# index.js and restart. Real environment variables always override it, so the
# same file also works where the panel does support them.

# ── required ────────────────────────────────────────────────────────────────
DISCORD_TOKEN=paste_your_token_here

# ── the one setting that matters on 256 MB ──────────────────────────────────
# Caps discord.js caches. Its defaults keep 200 messages per channel forever
# and never evict members, users or voice states — that growth, not the bot's
# own code, is what fills a small host.
#
# 'auto' would read the cgroup limit, but most panels do not expose one, so say
# it explicitly rather than letting the bot guess from the host's total RAM.
MEMORY_PROFILE=low

# ── recommended ─────────────────────────────────────────────────────────────
# Register commands to one server while setting up: applies instantly instead
# of taking up to an hour. Clear it once you are happy.
GUILD_ID=

# Your Discord user ID, so /owner and /plugin work.
OWNER_IDS=

# The panel console usually truncates scrollback. This keeps a bounded copy:
# total disk use is capped at LOG_FILE_MAX_BYTES * (LOG_FILE_KEEP + 1) ≈ 2 MB.
LOG_FILE=logs/bot.log
LOG_FILE_MAX_BYTES=524288
LOG_FILE_KEEP=3

# ── optional: switch off what you will not use ──────────────────────────────
# Each one removes its commands entirely. Fewer commands means slightly less
# memory and a shorter /help, but the saving is small — the caches dominate.
# FEATURE_ECONOMY=false
# FEATURE_GAMES=false
# FEATURE_LEVELING=false

# ── nothing is missing from this file ─────────────────────────────────────
# The V8 heap used to be the one setting that could not live here, because Node
# reads NODE_OPTIONS before any code runs. The bot now reads the cgroup limit
# and re-launches itself with the right value, so this file is the whole
# configuration. Set NODE_OPTIONS yourself only if you want to override it.
