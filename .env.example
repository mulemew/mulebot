# Copy this file to .env and fill in the values.
#
# This file is optional. If you inject environment variables through systemd,
# Docker or a PaaS dashboard, you can skip .env entirely - real environment
# variables take precedence over anything set here.
#   Linux/macOS:  DISCORD_TOKEN=xxx node index.js
#   PowerShell:   $env:DISCORD_TOKEN="xxx"; node index.js
#
# Only DISCORD_TOKEN is required. Everything else has a working default, and
# per-server behaviour is configured in Discord with /config, not here.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Get it at https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=paste_your_token_here

# ---------------------------------------------------------------------------
# Command registration
# ---------------------------------------------------------------------------

# Set a server ID to register commands to that server only, which applies
# instantly. Leave empty for global registration (up to 1 hour to propagate).
GUILD_ID=

# Set to false to skip registration on boot. Useful when restarting repeatedly
# during development, since Discord rate limits command updates per day.
REGISTER_COMMANDS=true

# Set to true to delete every registered command and exit. For retiring a bot.
CLEAR_COMMANDS=false

# ---------------------------------------------------------------------------
# Operator settings
# ---------------------------------------------------------------------------

# Comma separated user IDs. Owners bypass cooldowns and can use /owner and
# /plugin. Usually unnecessary: the application owner is fetched from Discord at
# startup, so whoever created the bot already counts. Set this to add others.
#
# A user ID is 17-20 digits. To find yours without turning on Developer Mode,
# type this in any Discord channel and send it - it prints your own ID back:
#
#     @yourname
#
# Quotes and the <@123> mention form are both accepted and stripped. Anything
# that is not an ID shape is ignored, and the bot says so at startup.
OWNER_IDS=

# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# Set to any value to disable ANSI colour, even on a terminal. Colour is already
# off automatically when stdout is not a TTY, which covers panels and files.
# NO_COLOR=1

# Optional log file. stdout is always written regardless — this is for hosts
# where nothing captures stdout. Rotation is size-based, so total disk use is
# capped at LOG_FILE_MAX_BYTES * (LOG_FILE_KEEP + 1). Leave empty to disable.
LOG_FILE=
LOG_FILE_MAX_BYTES=1048576
LOG_FILE_KEEP=4

# ---------------------------------------------------------------------------
# Memory
# ---------------------------------------------------------------------------
# auto | low | balanced | high
#
# Controls how much discord.js caches. Its defaults keep 200 messages per
# channel forever and never evict users, members or voice states, which is what
# makes a bot slowly consume a small VPS.
#
#   low        <= 512 MB hosts. 25 messages/channel, aggressive sweeping.
#              Trade-off: message deletes older than ~10 min are not logged.
#   balanced   <= 2 GB
#   high       > 2 GB, closest to discord.js defaults
#
# 'auto' reads the cgroup limit first, then host RAM — so a 256 MB container on
# a large host correctly picks 'low'.
MEMORY_PROFILE=auto

# The V8 heap is capped automatically. V8 sizes it from HOST memory, so inside a
# 256 MB container it plans for gigabytes, never collects under pressure, and
# gets OOM-killed with no stack trace. Only --max-old-space-size fixes that, and
# only if set before the process starts - which no file read at runtime can do,
# this one included. So the bot re-launches itself once with the right value.
#
# Setting the flag yourself, by either route below, disables the automatic path:
#   node --max-old-space-size=140 index.js
#   NODE_OPTIONS="--max-old-space-size=140"
#
# Set this to false to leave V8's own sizing alone and never re-launch. This one
# key is read straight from this file rather than through dotenv, because the
# hosts the feature exists for are the ones where a file is all you can change.
HEAP_AUTOSIZE=true

# Where guild settings, member records and scheduled tasks are stored,
# relative to index.js. Back this directory up.
DATA_DIR=data

# How often dirty data is written to disk, in milliseconds.
SAVE_INTERVAL=15000

# How many rotating backups of each data file to keep.
BACKUP_COUNT=3

# How often the persistent scheduler checks for due tasks, in milliseconds.
# Reminders and giveaways can therefore be late by up to this much.
SCHEDULER_TICK=5000

# ---------------------------------------------------------------------------
# Appearance
# ---------------------------------------------------------------------------

# Default language for new servers: en or zh-CN. Per-server: /config general language
BOT_LANG=en

# Default prefix for legacy text commands. Per-server: /config general prefix
PREFIX=!

# Presence shown in the member list.
ACTIVITY=/help
ACTIVITY_TYPE=Playing
STATUS=online

# Embed colours as decimal or 0x hex integers.
EMBED_COLOR=5793266
EMBED_COLOR_OK=5763719
EMBED_COLOR_WARN=16705372
EMBED_COLOR_ERROR=15548997

# Fallback welcome channel ID or name for servers that have not run /config.
WELCOME_CHANNEL=

# ---------------------------------------------------------------------------
# Plugins
# ---------------------------------------------------------------------------
# Drop a .js file into plugins/ and it loads on start. See plugins/README.md.
#
# A plugin runs inside this process with this process's privileges - it can read
# the token and the data directory. Loading one is as consequential as editing
# the bot's source. Set PLUGINS_ENABLED=false on a host where the plugins
# directory is not exclusively yours.

PLUGINS_ENABLED=true

# Where plugins live, relative to index.js.
PLUGINS_DIR=plugins

# Auto-reload a plugin when its file changes. Handy while writing one, a
# liability in production: an editor that saves in two chunks gets a
# half-written file loaded. Use /plugin reload instead.
PLUGIN_WATCH=false

# Where packages installed with /plugin npm are put. Defaults to the project
# directory; if that is read-only it falls back to DATA_DIR/npm, and then to a
# temporary directory. Set this when only one path is writable, e.g.
# PLUGIN_MODULES_DIR=/tmp/mulebot/npm
PLUGIN_MODULES_DIR=

# Run "npm install" for a directory plugin that declares dependencies in its
# package.json. Off by default: npm itself needs well over 100 MB, which on a
# 256 MB host is enough to get the container OOM-killed during startup. When off,
# the bot logs the exact install command instead.
PLUGIN_AUTO_INSTALL=false

# ---------------------------------------------------------------------------
# Feature master switches
# ---------------------------------------------------------------------------
# Switching one off here removes its commands everywhere, including from the
# command list. Individual servers can also disable features with /config.

FEATURE_LEVELING=true
FEATURE_ECONOMY=true
FEATURE_AUTOMOD=true
FEATURE_GAMES=true
FEATURE_TICKETS=true
FEATURE_GIVEAWAYS=true
FEATURE_STARBOARD=true
FEATURE_LOGGING=true
FEATURE_SUGGESTIONS=true
FEATURE_COUNTING=true
FEATURE_PREFIX=true

# ---------------------------------------------------------------------------
# Privileged intents
# ---------------------------------------------------------------------------
# There is nothing to set here, but this is where people get stuck.
#
# Two switches in the developer portal (your app -> Bot -> Privileged Gateway
# Intents) decide how much of the bot works:
#
#   SERVER MEMBERS INTENT   welcome messages, goodbye messages, autorole,
#                           member join/leave logging
#   MESSAGE CONTENT INTENT  automod, message XP, prefix commands,
#                           auto-responders, the counting game
#
# Slash commands work without either. If one is off, the bot logs exactly which
# features it lost on startup and keeps running rather than refusing to start.

# ---------------------------------------------------------------------------
# Read by bundled plugins, not by the bot itself
# ---------------------------------------------------------------------------

# httpserver.js — the status endpoint. When a PaaS injects PORT the plugin
# binds 0.0.0.0 so the platform health check can reach it; otherwise it binds
# localhost only. Also settable per-plugin in plugins/plugins.json.
# PORT=3000

# OWNER_ID is accepted as a single-value alias for OWNER_IDS.
# OWNER_ID=
